# העתיקי קובץ זה לשם ".env" והחליפי את הערכים. אסור להעלות את ".env" ל-GitHub.

# כתובת מסד הנתונים PostgreSQL (Connection String)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/seminar_dev"

# סוד להצפנת ה-JWT. לפחות 32 תווים אקראיים.
# ליצירה: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# תוקף ההתחברות (למשל 8h או 1d)
JWT_EXPIRES_IN="8h"

# הפורט (ב-Render הוא מוגדר אוטומטית)
PORT=3000

# מקורות מותרים ל-CORS, מופרדים בפסיק. לדוגמה כתובת ה-React שלך.
# "*" פירושו שכולם מותרים (מתאים רק לפיתוח).
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# --- נתוני הדגמה (Seed) ---
# בפיתוח (NODE_ENV שאינו production) נוצרים משתמשי הדגמה אוטומטית.
# בפרודקשן נוצרת מזכירה רק אם מגדירים את שני המשתנים הבאים:
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# אופציונלי: יצירת נתוני הדגמה גם בפרודקשן (true/false)
SEED_DEMO_DATA="false"
# סיסמה לחשבונות ההדגמה (חובה אם SEED_DEMO_DATA=true בפרודקשן; בפיתוח ברירת המחדל Password123!)
SEED_DEMO_PASSWORD=""
